# Optional: Google Gemini API key (free tier) for Gemini 3.8 Flash answers, quizzes, and data summaries.
# Without a key, all 5 HELIOS modules still run 100% locally using free open-source pipelines.
GEMINI_API_KEY=

# Local OpenAI Whisper model size for Lecture Sync (tiny, base, small)
WHISPER_MODEL_SIZE=base
